curl -s -o /dev/null -w '%{http_code}' https://github.com                       # -> 200

## 2. Browser tier (cold ~85 min; recipe in the pass-1 receipt header)
npm i --prefix /tmp/pw @sparticuz/chromium@153.0.0 playwright-core@1.63.0
git clone --depth 1 https://github.com/mozilla/nspr /tmp/nspr && (cd /tmp/nspr && ./configure --prefix=/tmp/nssroot --enable-64bit && make -j && make install)
git clone --depth 1 https://github.com/nss-dev/nss /tmp/nss && (cd /tmp/nss/nss && ./build.sh --disable-tests --with-nspr=/tmp/nssroot/include/nspr:/tmp/nssroot/lib)
# copy libnspr4/libnss3/libnssutil3 (+deps) into /tmp/browserlibs, then always run with LD_LIBRARY_PATH=/tmp/browserlibs

## 3. Product production-like dist at the anchor (same chain as the pass-1 receipt)
git clone https://github.com/FedorMilovanov/gb-is-my-strength /tmp/gb-product && git -C /tmp/gb-product checkout d586aa63f02b569cfe050a63cc9078c044375d8d
npm ci && npm run astro:build && node scripts/copy-legacy-to-dist.js --omit-build-only && npm run cache-bust && node scripts/heading-id-hygiene.js && node scripts/pastor-guards.js && npx pagefind --site dist
python3 -m http.server 8899 --directory dist --bind 127.0.0.1                    # local static host for the browser pass

