[Reproduction]
# From AuditRepo. PRODUCT is the absolute path to the exact source archive plus built dist and node_modules.
# Follow ../../arena-quiz-learning/2026-11-18/commands.log for installation and production-like build
# with GB_BUILD_INSTANT=2026-11-18T13:24:28Z. The files served in this phase were not changed.
# TOOLS is the Node 22.23.4 / @sparticuz/chromium 153.0.0 npm prefix with AL2023 libs/lib.
# CHROMIUM is the absolute executable path from Chromium.executablePath().
R=$(pwd)
D="$R/projects/gb-is-my-strength/incoming/arena-quiz-learning/2026-11-18"
G="$R/projects/gb-is-my-strength/incoming/arena-quiz-accessibility/2026-11-18"
OUT=$(mktemp -d "${TMPDIR:-/tmp}/gb-quiz-a11y.XXXXXX")
export PATH="$TOOLS/node_modules/.bin:$PATH"
export LD_LIBRARY_PATH="$TOOLS/libs/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
node --version
node --check "$G/harness/keyboard.mjs"
node "$D/harness/census.cjs" "$PRODUCT" "$OUT"
(cd "$PRODUCT" && node "$G/harness/keyboard.mjs" "$PRODUCT" "$OUT" "$CHROMIUM")
# Last argument can filter a scenario substring, e.g. sheet-boundary, sheet-escape, map-keyboard.
