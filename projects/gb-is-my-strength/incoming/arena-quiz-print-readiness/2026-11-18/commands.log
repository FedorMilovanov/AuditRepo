[Exact neighboring font bytes, no checkout or build of the stack]
FONTS=0b9576278d2ec5ea89da804934823d460720501a
JOURNAL=b2ae614730b0c2e164d3b07453797074253d9698
FONT_ROOT="$OUT/adjacent-fonts"
gh api "repos/FedorMilovanov/gb-is-my-strength/compare/$JOURNAL...$FONTS" --jq '.files[].filename' > "$OUT/neighbor-case-paths.txt"
# Only the nine known font filenames from this compare, no source or runtime changed.
grep -E '^fonts/(fonts\.css|[^/]+/[^/]+\.woff2)$' "$OUT/neighbor-case-paths.txt" > "$OUT/neighbor-assets.txt"
test "$(wc -l < "$OUT/neighbor-assets.txt")" -eq 9
while IFS= read -r f; do
  mkdir -p "$FONT_ROOT/$(dirname "$f")"
  gh api "repos/FedorMilovanov/gb-is-my-strength/contents/$f?ref=$FONTS" > "$OUT/asset.json"
  jq -r .content "$OUT/asset.json" | base64 -d > "$FONT_ROOT/$f"
  test "$(git hash-object --no-filters "$FONT_ROOT/$f")" = "$(jq -r .sha "$OUT/asset.json")"
done < "$OUT/neighbor-assets.txt"
